dyn_array AnyBytes : u32 * u8
dyn_array AnyString : u32 * u8 # UTF-8
dyn_array AnyArray : u32 * Any
dyn_array AnyMap : u32 * AnyKeyPair

seq AnyKeyPair
- key : Any
- value : Any

variant Any : u8
- Null = 0 => void
- Unsigned = 1 => u8
- Integer = 2 => i64
- Float = 3 => f64
- String = 4 => AnyString
- Array = 5 => AnyArray
- Map = 6 => AnyMap
- Bytes = 7 => AnyBytes
