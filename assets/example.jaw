# Global namespace only; case-sensitive; no name collisions allowed.

# ==== Builtin Types

# Primitives. All scalars are little endian:
# u8, u16, u32, u64
# i8, i16, i32, i64
# f32, f64

# Marker for nothing. This is useful for variants.
# void

# For opaque bytes and strings, use u8. These should be presented to readers as views


# ==== Example

# A pack is Plain Old Data and maps to a packed C struct (e.g., __attribute__((packed)) / #pragma pack(1)).
# No padding is inserted; 1-byte alignment; intended to be read/written in a single operation; contents must be POD.
pack MyPOD
- a_thing : u8
- b_thing : u64

# A fixed array is a consecutive array of items with unchanging size. It is POD iff the value type is POD.
fixed_array FixedString : 4 * u8

# A dynamic array is a list with runtime-determined size (never POD). The first type is the element-count type;
# the second is the element type. Readers must validate the count against remaining input to prevent overflow/OOM.
# For string-ish arrays, contents are UTF-8 and not null-terminated.
dyn_array ShortString : u8 * u8
dyn_array Data : u8 * f32

pack MyOtherPOD
- first : MyPOD
- second : FixedString

# Types can be given other names
alias Alpha : MyOtherPOD

# Enums are like C++ scoped enums. They must use an unsigned integer base type. Unknown discriminants are errors
# unless a default is defined.
enum PlainEnum : u8
- F1 = 0
- F2 = 1

# Enums can also define a default value to substitute when an unknown discriminant is read.
enum BetterEnum : u8
- A = 0
- B = 1
> DEFAULT = 255

# Bitfields/flags: the underlying type must be an integer or enum, and bit positions are numbered from LSB=0.
# On write, fields are masked/truncated to their declared width; on read, fields are zero-extended from that width.
# Readers may ignore bits not mapped to any field to preserve forward compatibility; writers should leave unspecified bits as zero.
bits MyFlags : u8
- 0    is_thing : u8
- 1-2  another_thing : u8
- 3-4  some_stuff : PlainEnum

# Sequences are ordered lists of items to read or write. They are like structs but are not read all at once;
# generators may expose view types to stream/peek without building the whole value.
seq SmallSeq
- list : Data

fixed_array MyPODFixedList : 8 * MyPOD
dyn_array MyOtherPODDynList : u16 * MyOtherPOD

seq ComplexSeq
- flags : MyFlags
- list : MyPODFixedList
- other_list : MyOtherPODDynList

# A variant is a branch with an unsigned integer discriminant and explicit options per value. Unknown discriminants
# are errors (no defaults). Variants may include void to represent an empty branch.
variant MyVariant : u8
- 1 => MyPOD
- 2 => MyOtherPOD
- 3 => void
- 4 => SmallSeq
- 5 => ComplexSeq

seq Root
- name : ShortString
- var : MyVariant
